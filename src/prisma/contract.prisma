// use prisma-8

model Restaurant {
  id              Int      @id @default(autoincrement())
  name            String
  address         String?
  city            String?
  category        String   @default("restaurant")
  activity        String   @default("commerce")
  ownerEmail      String?
  googlePlaceId   String?  @unique
  googleReviewUrl String?
  googlePlaceUrl  String?  @map("google_place_url")
  slug            String?  @unique
  autoRespondGooglePositive Boolean @default(false) @map("auto_respond_google_positive")
  ownerStatus     String?
  ownerFirstName  String?
  ownerLastName   String?
  postalCode      String?
  department      String?
  phone           String?
  passwordHash    String?
  trialEndsAt     TimestamptzString?
  subscriptionStatus String @default("trial") @map("subscription_status")
  stripeCustomerId String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  trialReminderSentAt TimestamptzString? @map("trial_reminder_sent_at")
  role            String @default("Owner")
  reviews         Review[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model Review {
  id             Int        @id @default(autoincrement())
  rating         Int
  comment        String?
  authorName     String?
  contact        String?
  cuisineRating  Int?
  serviceRating  Int?
  ambianceRating Int?
  visitMonth     Int?
  visitYear      Int?
  status         String     @default("INTERCEPTED")
  autoReplyText  String?
  clientEmailed  Boolean    @default(false)
  ownerNotified  Boolean    @default(false)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId   Int
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}
